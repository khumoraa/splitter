{
  "expo": {
    "name": "Receipt Splitter",
    "slug": "receipt-splitter",
    "icon": "./assets/icon.png",
    "scheme": "receipt-splitter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jduapp.receiptsplitter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Splitter uses the camera to scan receipts and QR invites.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Splitter lets you pick a receipt photo or an avatar from your library.",
          "cameraPermission": "Splitter uses the camera to scan receipts and QR invites.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05fc7a2d-813f-4121-9103-860ef1313a37"
      }
    },
    "owner": "jduapp"
  }
}
