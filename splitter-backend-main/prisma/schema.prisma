generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                   @id @default(autoincrement())
  email                 String                @unique
  password              String
  username              String
  uniqueId              String                @unique
  createdAt             DateTime              @default(now())
  avatarUrl             String?
  receivedFriendships   Friendship[]          @relation("UserFriendshipReceiver")
  sentFriendships       Friendship[]          @relation("UserFriendshipRequester")
  ownedGroups           Group[]               @relation("GroupOwner")
  groupMemberships      GroupMember[]
  itemAssignments       ItemAssignment[]
  sessionsCreated       Session[]             @relation("SessionCreator")
  sessionParticipates   SessionParticipant[]
  sessionHistoryEntries SessionHistoryEntry[]
  scanRequests          ScanRequest[]
  invitationsSent       GroupInvitation[]     @relation("InvitationInviter")
  invitationsReceived   GroupInvitation[]     @relation("InvitationInvitee")
  debts                 Obligation[]          @relation("ObligationDebtor")
  credits               Obligation[]          @relation("ObligationCreditor")
  paymentsRecorded      ObligationPayment[]   @relation("PaymentRecorder")
  paymentsResolved      ObligationPayment[]   @relation("PaymentResolver")
  obligationEvents      ObligationEvent[]
}

/// One receipt-scan attempt. Stores only the parsed result and the image hash, never the photo.
model ScanRequest {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageHash String
  idemKey   String?
  status    String
  errorCode String?
  charged   Boolean  @default(false)
  result    Json?
  createdAt DateTime @default(now())

  @@unique([userId, idemKey])
  @@index([userId, createdAt])
  @@index([userId, imageHash])
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  receiver    User             @relation("UserFriendshipReceiver", fields: [receiverId], references: [id])
  requester   User             @relation("UserFriendshipRequester", fields: [requesterId], references: [id])

  @@unique([requesterId, receiverId])
}

model Group {
  id          Int               @id @default(autoincrement())
  name        String
  ownerId     Int
  createdAt   DateTime          @default(now())
  owner       User              @relation("GroupOwner", fields: [ownerId], references: [id])
  members     GroupMember[]
  sessions    Session[]
  invitations GroupInvitation[]
}

model GroupMember {
  groupId  Int
  userId   Int
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
}

model Session {
  id              Int                  @id @default(autoincrement())
  creatorId       Int
  groupId         Int?
  receiptImageUrl String?
  serviceFee      Decimal              @default(0)
  total           Decimal              @default(0)
  status          SessionStatus        @default(ACTIVE)
  createdAt       DateTime             @default(now())
  items           ReceiptItem[]
  creator         User                 @relation("SessionCreator", fields: [creatorId], references: [id])
  group           Group?               @relation(fields: [groupId], references: [id])
  participants    SessionParticipant[]
  historyEntry    SessionHistoryEntry?
  obligations     Obligation[]
}

model SessionHistoryEntry {
  id                   Int      @id @default(autoincrement())
  sessionId            Int      @unique
  creatorId            Int
  sessionName          String?
  payload              Json
  participantUniqueIds String[] @default([])
  grandTotal           Decimal  @default(0)
  currency             String   @default("UNKNOWN")
  finalizedAt          DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  session              Session  @relation(fields: [sessionId], references: [id])
  creator              User     @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([participantUniqueIds], type: Gin)
}

model SessionParticipant {
  sessionId  Int
  userId     Int
  amountOwed Decimal @default(0)
  session    Session @relation(fields: [sessionId], references: [id])
  user       User    @relation(fields: [userId], references: [id])

  @@id([sessionId, userId])
}

model ReceiptItem {
  id          Int              @id @default(autoincrement())
  sessionId   Int
  name        String
  price       Decimal
  assignments ItemAssignment[]
  session     Session          @relation(fields: [sessionId], references: [id])
}

model ItemAssignment {
  itemId Int
  userId Int
  item   ReceiptItem @relation(fields: [itemId], references: [id])
  user   User        @relation(fields: [userId], references: [id])

  @@id([itemId, userId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum GroupRole {
  MEMBER
  ADMIN
}

enum SessionStatus {
  ACTIVE
  CLOSED
  CANCELED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// An owner's invitation for a registered user to join a group; the user must accept.
/// At most one PENDING row per (group, invitee): partial unique index added by hand in the migration SQL.
model GroupInvitation {
  id          Int              @id @default(autoincrement())
  groupId     Int
  inviterId   Int
  inviteeId   Int
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter     User             @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User             @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([groupId, status])
}

enum ObligationStatus {
  UNPAID
  PARTIALLY_PAID
  PAID_PENDING_CONFIRMATION
  PAID
  FORGIVEN
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PaymentMethod {
  CASH
  TRANSFER
  OTHER
}

/// What one person owes another for one bill. Money in integer minor units of `currency`.
/// The app never moves money: it only records debts and how they were settled outside the app.
/// CHECK constraints and a partial unique index (one live obligation per bill + debtor) live in the migration SQL.
model Obligation {
  id             Int                 @id @default(autoincrement())
  sessionId      Int
  debtorId       Int
  creditorId     Int
  amountMinor    Int
  currency       String
  status         ObligationStatus    @default(UNPAID)
  confirmedMinor Int                 @default(0)
  pendingMinor   Int                 @default(0)
  lastReminderAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  session        Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  debtor         User                @relation("ObligationDebtor", fields: [debtorId], references: [id])
  creditor       User                @relation("ObligationCreditor", fields: [creditorId], references: [id])
  payments       ObligationPayment[]
  events         ObligationEvent[]

  @@index([debtorId, status])
  @@index([creditorId, status])
  @@index([sessionId])
}

/// A settlement recorded outside the app: PENDING when the debtor says "I paid", CONFIRMED when the creditor confirms
/// or records it, REJECTED with a reason. Idempotency-Key makes a repeated request return the same row.
model ObligationPayment {
  id              Int           @id @default(autoincrement())
  obligationId    Int
  amountMinor     Int
  method          PaymentMethod
  note            String?
  status          PaymentStatus
  recordedById    Int
  resolvedById    Int?
  rejectionReason String?
  idemKey         String?
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?
  obligation      Obligation    @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  recordedBy      User          @relation("PaymentRecorder", fields: [recordedById], references: [id])
  resolvedBy      User?         @relation("PaymentResolver", fields: [resolvedById], references: [id])

  @@unique([obligationId, recordedById, idemKey])
  @@index([obligationId])
}

/// Append-only audit log (a trigger forbids UPDATE). Deleted only together with its bill or account.
model ObligationEvent {
  id           Int        @id @default(autoincrement())
  obligationId Int
  sessionId    Int
  actorId      Int
  type         String
  amountMinor  Int?
  paymentId    Int?
  note         String?
  createdAt    DateTime   @default(now())
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  actor        User       @relation(fields: [actorId], references: [id])

  @@index([obligationId, createdAt])
  @@index([sessionId])
}
