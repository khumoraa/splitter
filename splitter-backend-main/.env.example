# Environment variables for splitter-backend

# Server
PORT=3001

# JWT secret key
JWT_SECRET=your_jwt_secret_here

# Database URL (set by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Receipt recognition (Google Gemini). Without a key /sessions/scan answers 503.
GEMINI_API_KEY=

# Avatars: with R2_* and CDN_BASE_URL set they go to Cloudflare R2, otherwise to UPLOADS_DIR (default ./uploads) and are served at /media/avatars/...
# AVATAR_MAX_BYTES=5242880
# UPLOADS_DIR=./uploads
# PUBLIC_BASE_URL=https://api.example.com   # absolute URL prefix for avatar links; behind a proxy / in production

# Receipt scanning cost control (defaults shown). Per-user rolling windows of PAID AI calls.
# SCAN_LIMIT_DAILY=10
# SCAN_LIMIT_MONTHLY=100
# SCAN_CACHE_DAYS=30
# SCAN_MAX_IMAGE_BYTES=3000000
# GEMINI_MODEL_PARSE=gemini-3.5-flash
# Tests/demos only: fake AI (free). Honours the X-Mock-Ai header: ok | mismatch | not_receipt | garbage | unavailable
# ALLOW_MOCK_SCAN=true
